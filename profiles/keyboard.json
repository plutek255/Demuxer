{
  "name": "keyboard",
  "mode": "keyboard_mouse",
  "flex_sensitivity": {
    "thumb":  1.0,
    "index":  1.0,
    "middle": 1.0,
    "ring":   1.0,
    "pinky":  1.0
  },
  "flex_thresholds": {
    "tap":   0.45,
    "curl":  0.65,
    "grip":  0.70,
    "pinch": 0.55
  },
  "imu": {
    "jerk_threshold_ms2": 2.5,
    "twist_threshold_degs": 80.0,
    "tilt_threshold_deg": 25.0,
    "cooldown_ms": 400
  },
  "foil_mappings": {
    "A": "key_e",
    "B": "key_escape",
    "C": "key_v",
    "D": "modifier",
    "RECAL": "recalibrate"
  },
  "wheel": {
    "deadzone": 0.05,
    "lock_left_deg": -45.0,
    "lock_right_deg": 45.0
  },
  "fingerwalk": {
    "walk_threshold_tps": 1.5,
    "run_threshold_tps": 3.5
  },
  "gestures": {
    "jerk_forward":  "key_f",
    "jerk_backward": "key_q",
    "twist_left":    "key_r",
    "twist_right":   "key_r",
    "tilt_left":     "mouse_left",
    "tilt_right":    "mouse_right",
    "grip":          "mouse_left_click",
    "pinch":         "key_e"
  }
}
